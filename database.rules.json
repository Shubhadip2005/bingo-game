{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.hasChildren(['gridSize','status','hostId','players'])) || data.child('players').child(auth.uid).exists() || (data.child('status').val() === 'waiting' && newData.child('players').child(auth.uid).exists()))",
        ".validate": "newData.hasChildren(['gridSize','status','hostId','players'])",
        "gridSize": { ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 25" },
        "maxPlayers": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 5" },
        "status": { ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'setup' || newData.val() === 'playing' || newData.val() === 'finished')" }
      }
    },
    "boards": {
      "$roomId": {
        "$round": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('rooms').child($roomId).child('status').val() === 'finished')",
            ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && root.child('rooms').child($roomId).child('status').val() === 'setup' && root.child('rooms').child($roomId).child('players').child($uid).exists()",
            ".validate": "newData.hasChild('cells')"
          }
        }
      }
    }
  }
}
